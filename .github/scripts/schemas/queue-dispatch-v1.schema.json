{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": ".github/scripts/schemas/queue-dispatch-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "changeRef", "operation", "issueNumber", "attempt", "checkpoint"],
  "properties": {
    "$schema": { "const": ".github/scripts/schemas/queue-dispatch-v1.schema.json" },
    "changeRef": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "operation": { "enum": ["apply", "verify", "sync", "archive"] },
    "applyTask": { "type": "object" },
    "issueNumber": { "type": "integer", "minimum": 1 },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 2 },
    "checkpoint": { "type": "object" }
  }
}
