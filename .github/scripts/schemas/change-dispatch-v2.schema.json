{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": ".github/scripts/schemas/change-dispatch-v2.schema.json",
  "title": "OpenSpec agent session dispatch",
  "description": "Controller-selected envelope embedded in every Agent Task prompt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "change",
    "operation",
    "issue",
    "pr",
    "branch",
    "baseRef",
    "expectedHeadSha",
    "attempt",
    "answers"
  ],
  "properties": {
    "$schema": { "const": ".github/scripts/schemas/change-dispatch-v2.schema.json" },
    "change": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "operation": { "enum": ["apply", "verify", "sync", "archive"] },
    "issue": { "type": "integer", "minimum": 1 },
    "pr": { "type": "integer", "minimum": 1 },
    "branch": { "type": "string", "pattern": "^openspec/[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "baseRef": { "type": "string", "minLength": 1 },
    "expectedHeadSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "attempt": { "type": "integer", "minimum": 1 },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "capabilities", "capabilityPaths", "block"],
      "properties": {
        "id": { "type": "string", "pattern": "^\\d+(?:\\.\\d+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*$" }
        },
        "capabilityPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^openspec/capabilities/[a-z][a-z0-9]*\\.md$" }
        },
        "block": { "type": "string", "minLength": 1 }
      }
    },
    "feedback": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "text", "by"],
        "properties": {
          "question": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "by": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [{
    "if": { "properties": { "operation": { "const": "apply" } }, "required": ["operation"] },
    "then": { "required": ["task"] },
    "else": { "not": { "required": ["task"] } }
  }]
}
