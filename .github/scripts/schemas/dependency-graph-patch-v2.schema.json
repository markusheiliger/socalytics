{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": ".github/scripts/schemas/dependency-graph-patch-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "evaluationMode", "evaluatedRefs", "summaries", "upsert", "remove"],
  "properties": {
    "$schema": { "const": ".github/scripts/schemas/dependency-graph-patch-v2.schema.json" },
    "evaluationMode": { "enum": ["incremental", "full"] },
    "evaluatedRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "summaries": { "type": "array", "items": { "type": "object" } },
    "upsert": { "type": "array", "items": { "type": "object" } },
    "remove": { "type": "array", "items": { "type": "object" } }
  }
}
