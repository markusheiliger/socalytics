{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": ".github/scripts/schemas/change-marker-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "repository", "ref", "lifecycle", "gitRef", "path"],
  "properties": {
    "$schema": { "const": ".github/scripts/schemas/change-marker-v1.schema.json" },
    "repository": { "type": "string", "minLength": 1 },
    "ref": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "lifecycle": { "enum": ["active", "archived"] },
    "gitRef": { "type": "string", "minLength": 1 },
    "path": { "type": "string", "minLength": 1 }
  }
}
