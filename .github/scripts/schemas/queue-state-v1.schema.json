{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": ".github/scripts/schemas/queue-state-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "changeRef", "issueNumber", "status", "operation", "attempt", "taskId", "sessionId", "baseRef", "headRef", "beforeSha", "pullRequestNumber", "updatedAt"],
  "properties": {
    "$schema": { "const": ".github/scripts/schemas/queue-state-v1.schema.json" },
    "changeRef": { "type": "string" },
    "issueNumber": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["dispatching", "dispatched", "needs_attention", "awaiting_human_review"] },
    "operation": { "enum": ["apply", "verify", "sync", "archive"] },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 2 },
    "taskId": { "type": "string" },
    "sessionId": { "type": ["string", "null"] },
    "applyTaskId": { "type": ["string", "null"] },
    "applyTaskOwner": { "type": ["string", "null"] },
    "applyTaskCapabilities": { "type": ["array", "null"], "items": { "type": "string" } },
    "completedApplyTaskIds": { "type": "array", "items": { "type": "string" } },
    "baseRef": { "type": "string" },
    "headRef": { "type": ["string", "null"] },
    "beforeSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "pullRequestNumber": { "type": ["integer", "null"], "minimum": 1 },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
