{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspec/capabilities/schemas/capability-v1.schema.json",
  "title": "SocAlytics execution capability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "operations",
    "composition",
    "mutation",
    "isolation",
    "resultSchema"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*$"
    },
    "version": {
      "const": 1
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["propose", "update", "apply", "verify", "archive"]
      }
    },
    "composition": {
      "enum": ["composable", "exclusive"]
    },
    "mutation": {
      "enum": ["scoped", "checkbox-only", "none"]
    },
    "isolation": {
      "enum": ["shared", "required"]
    },
    "resultSchema": {
      "const": "openspec/capabilities/schemas/capability-result-v1.schema.json"
    }
  }
}
