{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socalytics.invalid/contracts/agent-catalog/tool-policy/v1/tool-policy.schema.json",
  "x-socalytics-version": "1.0.0",
  "title": "Agent tool policy v1",
  "description": "Immutable, digest-addressed Agent Catalog tool policy artifact: the permitted-tool subset of the eleven-tool allowlist for one agent version. Tool identifiers are written without parentheses. The artifact never carries credentials, endpoints, or other configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "version", "tools"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "tool-policy" },
    "id": { "type": "string", "minLength": 3, "maxLength": 100, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "version": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "enum": [
          "get_match",
          "get_player_stats",
          "find_counter_attacks",
          "find_turnovers",
          "get_heatmap",
          "find_ball_actions",
          "find_set_plays",
          "get_formations",
          "find_pressing_phases",
          "get_tactical_phases",
          "get_video_clip"
        ]
      }
    }
  }
}
