{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socalytics.invalid/contracts/agent-catalog/philosophy-profile/v1/philosophy-profile.schema.json",
  "x-socalytics-version": "1.0.0",
  "title": "Agent catalog philosophy profile v1",
  "description": "An immutable Coach base philosophy profile: one integer weight per dimension id of the referenced dimension-set version, keyed by dimension id (never positional). The platform, not this schema, checks that the keys equal the dimension set and that the weights total exactly 100. Weights are provisional hypotheses that require football-domain review, not biographical facts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "version", "dimensionSet", "weights", "author", "reviewers"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "philosophy-profile" },
    "id": { "$ref": "#/$defs/kebabId" },
    "version": { "$ref": "#/$defs/semVer" },
    "dimensionSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/kebabId" },
        "version": { "$ref": "#/$defs/semVer" }
      }
    },
    "weights": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": { "$ref": "#/$defs/kebabId" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["weight", "rationale", "provenance"],
        "properties": {
          "weight": { "type": "integer", "minimum": 0, "maximum": 100 },
          "rationale": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "provenance": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "author": { "type": "string", "minLength": 1, "maxLength": 200 },
    "reviewers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "footballDomain"],
      "properties": {
        "architecture": { "$ref": "#/$defs/reviewerList" },
        "footballDomain": { "$ref": "#/$defs/reviewerList" }
      }
    },
    "supersedes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": { "$ref": "#/$defs/semVer" }
      }
    }
  },
  "$defs": {
    "kebabId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "semVer": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "reviewerList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    }
  }
}
