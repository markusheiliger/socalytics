{
  "manifestVersion": "1.2.0",
  "capability": {
    "id": "pressing-analysis",
    "version": "2.1.0",
    "tier": "high-level",
    "executionScope": "match"
  },
  "upstream": [
    { "capabilityId": "player-detection", "capabilityVersion": "1.3.0", "schemaVersion": "1.1.0", "kind": "required" }
  ],
  "videoAccess": "forbidden",
  "output": {
    "schemaVersion": "2.1.0",
    "factPayloadSchemas": {
      "pressing-sequence": {
        "type": "object",
        "required": ["intensity", "players"],
        "additionalProperties": false,
        "properties": {
          "intensity": { "type": "number", "minimum": 0, "maximum": 10 },
          "phase": { "enum": ["build-up", "mid-block", "high-press"] },
          "players": {
            "type": "array",
            "minItems": 1,
            "maxItems": 11,
            "items": { "type": "integer", "minimum": 0 }
          },
          "recovered": { "type": "boolean" }
        }
      },
      "pressing-summary": {
        "type": "object",
        "required": ["sequences"],
        "additionalProperties": false,
        "properties": {
          "sequences": { "type": "integer", "minimum": 0 },
          "note": { "type": "string", "maxLength": 200 }
        }
      }
    }
  },
  "compatibleProfiles": ["cpu-standard", "gpu-standard"],
  "model": { "digest": "sha-256:fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210" },
  "runtime": { "constraints": ["linux-amd64"], "accelerators": [] },
  "resources": { "memory": "4Gi" },
  "requirements": {
    "minMaxAttempts": 2,
    "minLeaseSeconds": 30,
    "minStaleTimeoutSeconds": 90,
    "minExecutionTimeoutSeconds": 600
  },
  "determinism": { "deterministic": false, "idempotent": true }
}
