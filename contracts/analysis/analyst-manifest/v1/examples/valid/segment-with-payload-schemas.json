{
  "manifestVersion": "1.2.0",
  "capability": {
    "id": "player-detection",
    "version": "1.3.0",
    "tier": "low-level",
    "executionScope": "segment"
  },
  "upstream": [],
  "videoAccess": "required",
  "output": {
    "schemaVersion": "1.1.0",
    "factPayloadSchemas": {
      "player-detection": {
        "type": "object",
        "required": ["playerId", "confidence", "box"],
        "additionalProperties": false,
        "properties": {
          "playerId": { "type": "integer", "minimum": 0 },
          "team": { "enum": ["home", "away", "unknown"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "box": { "$ref": "#/$defs/box" },
          "keypoints": {
            "type": "array",
            "minItems": 0,
            "maxItems": 17,
            "items": { "$ref": "#/$defs/point" }
          }
        },
        "$defs": {
          "point": {
            "type": "object",
            "required": ["x", "y"],
            "additionalProperties": false,
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          },
          "box": {
            "type": "object",
            "required": ["x", "y", "width", "height"],
            "additionalProperties": false,
            "properties": {
              "x": { "type": "number", "minimum": 0 },
              "y": { "type": "number", "minimum": 0 },
              "width": { "type": "number", "exclusiveMinimum": 0 },
              "height": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      },
      "frame-quality": {
        "type": "object",
        "required": ["sharpness"],
        "additionalProperties": false,
        "properties": {
          "sharpness": { "type": "number", "minimum": 0, "maximum": 1 },
          "label": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      }
    }
  },
  "compatibleProfiles": ["gpu-standard"],
  "model": { "digest": "sha-256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" },
  "runtime": { "constraints": ["linux-amd64"], "accelerators": ["cuda"] },
  "resources": { "memory": "8Gi", "cpu": "4" },
  "requirements": {
    "minMaxAttempts": 3,
    "minLeaseSeconds": 60,
    "minStaleTimeoutSeconds": 120,
    "minExecutionTimeoutSeconds": 900
  },
  "determinism": { "deterministic": true, "idempotent": true }
}
