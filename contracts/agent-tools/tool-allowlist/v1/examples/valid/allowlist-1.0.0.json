  "tools": [
    {
      "toolId": "get_match",
      "operationId": "agentToolGetMatch",
      "method": "POST",
      "pathTemplate": "/api/v1/agent-tools/attempts/{attemptId}/get-match",
      "answers": "accepted-evidence",
      "producingCapability": null,
      "argumentsSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "facts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capabilityId", "capabilityVersion", "schemaVersion"],
            "properties": {
              "capabilityId": { "type": "string" },
              "capabilityVersion": { "type": "string" },
              "schemaVersion": { "type": "string" },
              "nodeKey": { "type": "string" },
              "fromMs": { "type": "integer", "minimum": 0 },
              "toMs": { "type": "integer", "minimum": 0 },
              "pageSize": { "type": "integer", "minimum": 1 },
              "continuationToken": { "type": "string" }
            }
          }
        }
      },
      "resultSchema": {
        "type": "object",
        "required": ["match", "run", "streams"],
        "properties": {
          "match": { "type": "object" },
          "run": { "type": "object" },
          "streams": { "type": "array" },
          "facts": { "type": "object" }
        }
      }
    },
    {
