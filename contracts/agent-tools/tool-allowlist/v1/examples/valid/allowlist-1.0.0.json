      "method": "POST",
      "pathTemplate": "/api/v1/agent-tools/attempts/{attemptId}/get-video-clip",
      "answers": "accepted-evidence",
      "producingCapability": null,
      "argumentsSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["acceptedResultId", "ordinal"],
            "properties": {
              "acceptedResultId": { "type": "string" },
              "ordinal": { "type": "integer", "minimum": 0 },
              "contextBeforeMs": { "type": "integer", "minimum": 0 },
              "contextAfterMs": { "type": "integer", "minimum": 0 }
            }
          },
          "range": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fromMs", "toMs"],
            "properties": {
              "fromMs": { "type": "integer", "minimum": 0 },
              "toMs": { "type": "integer", "minimum": 0 }
            }
          },
          "retryFailed": { "type": "boolean" }
        },
        "oneOf": [{ "required": ["fact"] }, { "required": ["range"] }]
      },
      "resultSchema": {
        "type": "object",
        "required": ["run", "requested", "shortened", "parts"],
        "properties": {
          "run": { "type": "object" },
          "requested": { "type": "object" },
          "fact": { "type": "object" },
          "shortened": { "type": "boolean" },
          "parts": { "type": "array" }
        }
      }
    },
