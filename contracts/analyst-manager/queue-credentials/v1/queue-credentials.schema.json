{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socalytics.invalid/contracts/analyst-manager/queue-credentials/v1/queue-credentials.schema.json",
  "x-socalytics-version": "1.0.0",
  "title": "Analyst Manager queue credentials",
  "description": "Request and response of POST /api/v1/analyst-managers/self/queue-credentials. The request carries only a NATS user public key, never a seed. The socalytics.invalid domain is reserved and never dereferenced.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "userPublicKey": {
      "description": "NATS user NKey public key: prefix U followed by 55 base32 characters.",
      "type": "string",
      "pattern": "^U[A-Z2-7]{55}$"
    },
    "capabilityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[a-z0-9][a-z0-9._\\-]*$" },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userPublicKey", "capabilities"],
      "properties": {
        "userPublicKey": { "$ref": "#/$defs/userPublicKey" },
        "capabilities": { "type": "array", "items": { "$ref": "#/$defs/capabilityRef" } }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userJwt", "expiresAt", "queueUrl", "stream", "consumers", "inboxPrefix", "maxConcurrentAnalysts"],
      "properties": {
        "userJwt": { "type": "string", "minLength": 1 },
        "expiresAt": { "type": "string", "format": "date-time" },
        "queueUrl": { "type": "string", "pattern": "^(nats|tls)://\\S+$" },
        "stream": { "type": "string", "minLength": 1 },
        "consumers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capability", "consumer"],
            "properties": {
              "capability": { "type": "string", "minLength": 1 },
              "consumer": { "type": "string", "minLength": 1 }
            }
          }
        },
        "inboxPrefix": { "type": "string", "minLength": 1 },
        "maxConcurrentAnalysts": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "examples": [
    {
      "userPublicKey": "UDXU4RCSJNZOIQHZNWXHXORDPRTGNJAHAHFRGZNEEJCPQTT2M7NLCNF4",
      "capabilities": [ { "id": "player-detection", "version": "1.0.0" } ]
    }
  ]
}
