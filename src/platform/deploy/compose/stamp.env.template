# SocAlytics Compose evaluation stamp: environment file template.
# This file is for self-hosted evaluation. It is not a production profile.
# The setup step (StampSetup) fills the secrets and the setup values; you fill the operator values.
# Kinds: setup (written by the setup step), operator (you supply it), secret (generated by the setup step),
# optional secret (you may supply it; leave both relay credentials empty or set both).
# Every value is empty here: there is no default for any value, in particular no secret.
# "Open / Blocking" marks a production profile value that stays unresolved; an evaluation choice is never an approved value.

# setup: absolute path of the stamp directory that holds stamp.env and nats.conf (mounted by nats).
SOCALYTICS_STAMP_DIR=

# operator: reference of the API image of one release.
SOCALYTICS_API_IMAGE=

# operator: reference of the Migrator image of the same release.
SOCALYTICS_MIGRATOR_IMAGE=

# operator: reference of the Web UI image of the same release.
SOCALYTICS_WEB_IMAGE=

# operator: release version of the images; becomes WebUi__MinimumVersion of the API.
SOCALYTICS_RELEASE_VERSION=

# operator, production profile value (Open / Blocking): loopback port of the Web UI; also forms http://localhost:<port> for links.
SOCALYTICS_WEB_PORT=

# operator: identifier of this stamp; becomes Stamp__Id of the API.
SOCALYTICS_STAMP_ID=

# operator, production profile value (Open / Blocking): https placeholder base URI of the stamp (Stamp__PublicBaseUri); no endpoint is behind it.
SOCALYTICS_PUBLIC_BASE_URI=

# operator: display name of the club created at bootstrap.
SOCALYTICS_CLUB_DISPLAY_NAME=

# operator: account name of the first Club Admin created at bootstrap.
SOCALYTICS_FIRST_CLUB_ADMIN_ACCOUNT_NAME=

# secret: initial password of the first Club Admin (changed at first sign-in).
SOCALYTICS_FIRST_CLUB_ADMIN_INITIAL_PASSWORD=

# secret: PostgreSQL administrator password.
SOCALYTICS_POSTGRES_PASSWORD=

# secret: password of the PostgreSQL role used by the Migrator.
SOCALYTICS_MIGRATOR_DB_PASSWORD=

# secret: password of the PostgreSQL role used by the API.
SOCALYTICS_APP_DB_PASSWORD=

# secret: object storage access key.
SOCALYTICS_STORAGE_ACCESS_KEY=

# secret: object storage secret key.
SOCALYTICS_STORAGE_SECRET_KEY=

# secret: NATS operator seed for JWT authentication.
SOCALYTICS_NATS_OPERATOR_SEED=

# secret: NATS stamp account seed for JWT authentication.
SOCALYTICS_NATS_ACCOUNT_SEED=

# secret: NATS system account seed for JWT authentication.
SOCALYTICS_NATS_SYSTEM_ACCOUNT_SEED=

# operator, production profile value (Open / Blocking): SMTP relay host. The placeholder relay smtp.invalid never delivers; delivery attempts fail and are recorded.
SOCALYTICS_SMTP_HOST=

# operator, production profile value (Open / Blocking): SMTP relay port. The placeholder is 587.
SOCALYTICS_SMTP_PORT=

# operator, production profile value (Open / Blocking): SMTP security. The placeholder is StartTls; StartTls or SslOnConnect are the only values allowed outside Development.
SOCALYTICS_SMTP_SECURITY=

# optional secret: SMTP relay user name; set both relay credentials or neither.
SOCALYTICS_SMTP_USERNAME=

# optional secret: SMTP relay password; set both relay credentials or neither.
SOCALYTICS_SMTP_PASSWORD=

# operator, production profile value (Open / Blocking): sender address of transactional email.
SOCALYTICS_SENDER_ADDRESS=

# operator, production profile value (Open / Blocking): sender display name of transactional email.
SOCALYTICS_SENDER_NAME=
