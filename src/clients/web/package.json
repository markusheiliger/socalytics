{
  "name": "socalytics-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "generate": "kiota generate --language typescript --openapi ../../platform/SocAlytics.Platform.Api/openapi/v1.json --output src/generated/platform-api --class-name PlatformApiClient --clean-output",
    "build": "npm run generate && tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@microsoft/kiota-bundle": "1.0.0-preview.110",
    "@mui/material": "7.3.11",
    "@tanstack/react-query": "5.104.2",
    "i18next": "26.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
