{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "composite": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "node_modules/.tmp/tsc-node",
    "types": ["node"]
  },
  "include": ["vite.config.ts", "build", "src/serviceWorker/version.ts", "vitest.config.ts", "playwright.config.ts", "tests/e2e", "src/generated"]
}
