<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../../../../contracts/analyst-manager/**/*" LinkBase="contracts/analyst-manager" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../../../contracts/analysis/upstream-results/**/*" LinkBase="contracts/analysis/upstream-results" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../../../contracts/analysis/attempt-completion/**/*" LinkBase="contracts/analysis/attempt-completion" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../../../contracts/common/**/*" LinkBase="contracts/common" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../../../contracts/analysis/result-manifest/**/*" LinkBase="contracts/analysis/result-manifest" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../contracts/local-control.schema.json" LinkBase="contracts" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SocAlytics.Analysts.Manager.Core\SocAlytics.Analysts.Manager.Core.csproj" />
    <ProjectReference Include="..\..\SocAlytics.Analysts.Manager\SocAlytics.Analysts.Manager.csproj" />
    <ProjectReference Include="..\..\SocAlytics.Analysts.Manager.Server\SocAlytics.Analysts.Manager.Server.csproj" />
  </ItemGroup>
</Project>
