{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socalytics.example/schemas/analyst-evaluation-harness/corpus-manifest/1.0.0",
  "title": "Corpus manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "corpusId", "corpusVersion", "identity", "rights", "clips"],
  "properties": {
    "manifestVersion": { "const": "1.0.0" },
    "corpusId": { "$ref": "#/$defs/key" },
    "corpusVersion": { "$ref": "#/$defs/semver" },
    "identity": { "$ref": "#/$defs/digest" },
    "rights": { "$ref": "#/$defs/rights" },
    "clips": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/clip" } }
  },
  "$defs": {
    "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "digest": { "type": "string", "pattern": "^sha-256:[0-9a-f]{64}$" },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "license", "production"],
      "properties": {
        "origin": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "production": { "type": "string", "minLength": 1 }
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clipId", "file", "digest", "profile", "frameRate", "durationMs", "matchStartMs", "rights", "labels"],
      "properties": {
        "clipId": { "$ref": "#/$defs/key" },
        "file": { "type": "string", "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$", "not": { "pattern": "(^|/)\\.\\.(/|$)" } },
        "digest": { "$ref": "#/$defs/digest" },
        "profile": { "enum": ["fixed", "broadcast"] },
        "frameRate": { "type": "number", "exclusiveMinimum": 0 },
        "durationMs": { "type": "integer", "minimum": 1 },
        "matchStartMs": { "type": "integer", "minimum": 0 },
        "rights": { "$ref": "#/$defs/rights" },
        "labels": { "type": "array", "items": { "$ref": "#/$defs/label" } }
      }
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["labelKind"],
      "properties": {
        "labelKind": { "$ref": "#/$defs/key" },
        "positionMs": { "type": "integer", "minimum": 0 },
        "rangeStartMs": { "type": "integer", "minimum": 0 },
        "rangeEndMs": { "type": "integer", "minimum": 0 },
        "payload": { "type": "object" }
      },
      "oneOf": [
        { "required": ["positionMs"], "not": { "anyOf": [{ "required": ["rangeStartMs"] }, { "required": ["rangeEndMs"] }] } },
        { "required": ["rangeStartMs", "rangeEndMs"], "not": { "required": ["positionMs"] } }
      ]
    }
  }
}
